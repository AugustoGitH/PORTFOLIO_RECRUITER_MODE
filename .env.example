# URL pública canônica usada pelo metadata e pelos cards sociais.
NEXT_PUBLIC_SITE_URL=https://augustowestphal.netlify.app

# A URL nunca deve receber o prefixo NEXT_PUBLIC_. O banco indicado no caminho
# da URI será usado pelos Route Handlers server-side.
MONGO_URL=mongodb://admin:admin@localhost:27017/portfolio?authSource=admin
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=augustoportfolio
R2_PUBLIC_BASE_URL=

# Gere com: openssl rand -base64 32. Nunca exponha esta chave ao browser.
ADMIN_JWT_ENCRYPTION_KEY=
ADMIN_JWT_KEY_ID=active
