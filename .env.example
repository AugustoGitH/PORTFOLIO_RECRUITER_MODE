# URL pública canônica usada pelo metadata e pelos cards sociais.
NEXT_PUBLIC_SITE_URL=https://www.augustowestphal.com.br

# Railway fornece esta variável automaticamente no deploy. Defina-a localmente
# como `development`; o ambiente principal do Railway usa `production`.
RAILWAY_ENVIRONMENT_NAME=development

# URLs privadas do MongoDB. Em desenvolvimento, a aplicação e os scripts usam
# MONGO_URL_DEV, com fallback para MONGO_URL. Em produção, usam apenas MONGO_URL.
# O banco indicado no caminho da URI será usado pelo código server-side.
# MongoDB de desenvolvimento
MONGO_URL_DEV=mongodb://admin:admin@localhost:27017/portfolio?authSource=admin

# MongoDB de produção
MONGO_INITDB_ROOT_PASSWORD=
MONGO_INITDB_ROOT_USERNAME=
MONGO_URL=
MONGOHOST=
MONGOPASSWORD=
MONGOPORT=
MONGOUSER=

R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=augustoportfolio
R2_PUBLIC_BASE_URL=

# Gere com: openssl rand -base64 32. Nunca exponha esta chave ao browser.
ADMIN_JWT_ENCRYPTION_KEY=
ADMIN_JWT_KEY_ID=active
